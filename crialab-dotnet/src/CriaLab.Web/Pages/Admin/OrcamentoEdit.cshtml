@page "{id}"
@model CriaLab.Web.Pages.Admin.OrcamentoEditModel
@{
    ViewData["Title"] = "Editar orçamento";
}
<div class="admin-prod-cab">
    <div>
        <h1 class="m-0">@Model.Orcamento.Nome</h1>
        <p class="admin-prod-intro m-0 mt-1">Cálculo simplificado de custo e preço sugerido.</p>
    </div>
    <a class="botao-linha" asp-page="/Admin/Orcamentos">Voltar</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <p class="cta-ok">@ok</p>
}

<form method="post" class="cartao formulario admin-prod-form" id="form-orc">
    <input type="hidden" asp-for="Orcamento.Id" />
    <input type="hidden" asp-for="ItensJson" id="ItensJson" />

    <div class="grade grid grid-cols-1 gap-4 lg:grid-cols-2">
        <label>Nome<input asp-for="Orcamento.Nome" required /></label>
        <label>Material<input asp-for="Orcamento.Material" /></label>
        <label>Minutos<input asp-for="Orcamento.Minutos" type="number" min="0" /></label>
        <label>Peso (g)<input asp-for="Orcamento.PesoG" type="number" step="0.01" min="0" /></label>
        <label>Lixo (g)<input asp-for="Orcamento.LixoG" type="number" step="0.01" min="0" /></label>
        <label>Preço kg (R$)<input asp-for="Orcamento.PrecoKg" type="number" step="0.01" min="0" /></label>
        <label>Energia / min<input asp-for="Orcamento.EnergiaPorMinuto" type="number" step="0.0001" min="0" /></label>
        <label>Depreciação<input asp-for="Orcamento.Depreciacao" type="number" step="0.01" min="0" /></label>
        <label>Manutenção<input asp-for="Orcamento.Manutencao" type="number" step="0.01" min="0" /></label>
        <label>Serviço<input asp-for="Orcamento.Servico" type="number" step="0.01" min="0" /></label>
        <label>Taxa falha (0–1)<input asp-for="Orcamento.TaxaFalha" type="number" step="0.01" min="0" max="1" /></label>
        <label>Margem site (0–1)<input asp-for="Orcamento.MargemSite" type="number" step="0.01" min="0" max="0.99" /></label>
        <label>Frete canal<input asp-for="Orcamento.FreteCanal" type="number" step="0.01" min="0" /></label>
        <label class="flex items-center gap-2 font-semibold"><input asp-for="Orcamento.Enviado" type="checkbox" style="width:auto;min-height:auto" /> Enviado</label>
    </div>

    <section class="var-admin mt-4">
        <div class="var-admin-topo">
            <div>
                <h2 class="m-0">Itens extras</h2>
                <p class="var-admin-ajuda m-0">Embalagem, pintura, frete interno…</p>
            </div>
            <button class="botao-linha" type="button" id="add-item">+ Item</button>
        </div>
        <div id="itens-lista"></div>
    </section>

    <div class="cartao mt-4 p-4 bg-creme">
        <p class="m-0">Material R$ @Model.CustoMaterial.ToString("N2") · Energia R$ @Model.CustoEnergia.ToString("N2")</p>
        <p class="m-0">Custo base R$ @Model.CustoBase.ToString("N2")</p>
        <p class="numero-grande m-0 mt-2">Preço sugerido R$ @Model.PrecoSugerido.ToString("N2")</p>
    </div>

    <div class="flex flex-wrap gap-2 mt-4">
        <button class="botao" type="submit">Salvar</button>
        <a class="botao-linha" asp-page="/Admin/Orcamentos">Cancelar</a>
    </div>
</form>

@section Scripts {
<script>
(function () {
  var itens = [];
  try { itens = JSON.parse(document.getElementById("ItensJson").value || "[]") || []; } catch (e) { itens = []; }
  function esc(s) { return String(s == null ? "" : s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/"/g,"&quot;"); }
  function coletar() {
    document.querySelectorAll("[data-item-i]").forEach(function (card) {
      var i = Number(card.getAttribute("data-item-i"));
      if (!itens[i]) return;
      var n = card.querySelector("[data-c=nome]");
      var q = card.querySelector("[data-c=qtd]");
      var p = card.querySelector("[data-c=preco]");
      if (n) itens[i].nome = n.value;
      if (q) itens[i].quantidade = Number(q.value) || 0;
      if (p) itens[i].preco = Number(p.value) || 0;
    });
  }
  function pintar() {
    var lista = document.getElementById("itens-lista");
    if (!itens.length) { lista.innerHTML = '<p class="var-admin-vazia">Nenhum item extra.</p>'; return; }
    lista.innerHTML = itens.map(function (it, i) {
      return '<article class="var-eixo" data-item-i="' + i + '"><div class="var-eixo-cab">' +
        '<label class="fin-campo"><span>Nome</span><input data-c="nome" value="' + esc(it.nome || it.Nome || "") + '"></label>' +
        '<label class="fin-campo"><span>Qtd</span><input data-c="qtd" type="number" step="0.01" value="' + (it.quantidade ?? it.Quantidade ?? 1) + '"></label>' +
        '<label class="fin-campo"><span>Preço</span><input data-c="preco" type="number" step="0.01" value="' + (it.preco ?? it.Preco ?? 0) + '"></label>' +
        '<button class="botao-linha" type="button" data-rm="' + i + '">Remover</button></div></article>';
    }).join("");
    lista.querySelectorAll("[data-rm]").forEach(function (b) {
      b.addEventListener("click", function () { coletar(); itens.splice(Number(b.getAttribute("data-rm")), 1); pintar(); });
    });
  }
  document.getElementById("add-item").addEventListener("click", function () {
    coletar();
    itens.push({ nome: "Item", quantidade: 1, preco: 0 });
    pintar();
  });
  document.getElementById("form-orc").addEventListener("submit", function () {
    coletar();
    document.getElementById("ItensJson").value = JSON.stringify(itens);
  });
  pintar();
})();
</script>
}
