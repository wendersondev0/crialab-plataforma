@page
@model CriaLab.Web.Pages.Admin.PatrimonioModel
@using CriaLab.Web.Pages.Admin
@{
    ViewData["Title"] = "Patrimônio · Administração";
    string Kpi(string aba) => "admin-prod-kpi" + (Model.Aba == aba ? " ativo" : "");
}
<div class="admin-prod-cab">
    <div>
        <h1 class="m-0">Patrimônio e estoque</h1>
        <p class="admin-prod-intro m-0 mt-1">Estoque alinhado às planilhas de gastos: PLA/PETG/TPU por cor, LED, copos, argolas, caixas, NFC e ferramentas. Toque no card para ajustar saldos.</p>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <p class="cta-ok">@ok</p>
}

<div class="admin-prod-kpis pat-kpis">
    <a class="@Kpi("tudo")" asp-page="/Admin/Patrimonio" asp-route-aba="tudo" asp-route-q="@Model.Q"><strong>@Model.TotalTudo</strong><span>Tudo</span></a>
    <a class="@Kpi("impressoras")" asp-page="/Admin/Patrimonio" asp-route-aba="impressoras" asp-route-q="@Model.Q"><strong>@Model.QtdImpressoras</strong><span>Impressoras</span></a>
    <a class="@Kpi("filamentos")" asp-page="/Admin/Patrimonio" asp-route-aba="filamentos" asp-route-q="@Model.Q"><strong>@Model.QtdFilamentos</strong><span>Filamentos</span></a>
    <a class="@Kpi("embalagens")" asp-page="/Admin/Patrimonio" asp-route-aba="embalagens" asp-route-q="@Model.Q"><strong>@Model.QtdEmbalagens</strong><span>Embalagens</span></a>
    <a class="@Kpi("insumos")" asp-page="/Admin/Patrimonio" asp-route-aba="insumos" asp-route-q="@Model.Q"><strong>@Model.QtdInsumosOutros</strong><span>Insumos</span></a>
    <a class="@Kpi("equipamentos")" asp-page="/Admin/Patrimonio" asp-route-aba="equipamentos" asp-route-q="@Model.Q"><strong>@Model.QtdEquipamentos</strong><span>Ferramentas</span></a>
</div>

<div class="admin-prod-fluxo">
    <a class="botao-linha admin-fluxo@(Model.Aba == "compras" ? " ativo-fluxo" : "")" asp-page="/Admin/Patrimonio" asp-route-aba="compras">
        <span class="ico"><partial name="_SvgIcon" model="@("documento")" /></span><span>Compras da planilha</span>
    </a>
    <a class="botao-linha admin-fluxo" asp-page="/Admin/Impressao" asp-route-aba="mesa">
        <span class="ico"><partial name="_SvgIcon" model="@("admin")" /></span><span>Mesa de impressão</span>
    </a>
    <a class="botao-linha admin-fluxo" asp-page="/Admin/Impressao" asp-route-aba="fila">
        <span class="ico"><partial name="_SvgIcon" model="@("estoque")" /></span><span>Fila de impressões</span>
    </a>
</div>

@if (Model.Aba != "compras")
{
    <form method="get" class="at-busca" id="pat-busca">
        <input type="hidden" name="aba" value="@Model.Aba" />
        <label class="campo-busca">
            <span class="visually-hidden">Buscar</span>
            <span class="ico"><partial name="_SvgIcon" model="@("busca")" /></span>
            <input name="q" type="search" value="@Model.Q" placeholder="Buscar caixa, fita, bolha, papel foto, filamento..." />
        </label>
        @if (Model.Alertas > 0)
        {
            <span class="pat-kpi-alerta">@Model.Alertas item@(Model.Alertas == 1 ? "" : "s") abaixo do mínimo</span>
        }
    </form>
}

<div class="admin-prod-painel cartao at-painel">
@if (Model.Aba == "compras")
{
    <div class="pat-compras">
    @if (Model.Compras.Any())
    {
        @foreach (var c in Model.Compras)
        {
            <article class="pat-compra">
                <strong>@c.Descricao</strong>
                <span>@PatrimonioModel.CompetenciaBr(c.Competencia)</span>
                <span>R$ @c.Valor.ToString("N2")</span>
            </article>
        }
    }
    else
    {
        <div class="vazio"><p>Nenhuma compra de investimento lançada.</p></div>
    }
    </div>
}
else
{
    @if (Model.Maquinas.Any())
    {
        <section class="pat-sec">
            <h2 class="pat-sec-titulo">@Model.TituloSecaoMaquinas</h2>
            <div class="pat-grade">
            @foreach (var m in Model.Maquinas)
            {
                var aberto = Model.Aberto == m.Id;
                <article class="pat-card@(aberto ? " aberto" : "")" data-id="@m.Id" data-tipo="maquina">
                    <a class="pat-card-btn no-underline text-tinta" asp-page="/Admin/Patrimonio" asp-route-aba="@Model.Aba" asp-route-q="@Model.Q" asp-route-id="@(aberto ? null : m.Id)">
                        <span class="pat-foto">
                            @if (!string.IsNullOrWhiteSpace(m.Imagem))
                            {
                                <img class="pat-thumb" src="~/@m.Imagem" alt="" />
                            }
                            else
                            {
                                <span class="pat-thumb vazia"><span class="ico"><partial name="_SvgIcon" model="@("estoque")" /></span></span>
                            }
                            <span class="pat-cat">@PatrimonioModel.NomeCat(m.Categoria)</span>
                        </span>
                        <span class="pat-info">
                            <strong class="pat-nome">@m.Nome</strong>
                            <span class="pat-meta">Aquisição @PatrimonioModel.DataAq(m.AdquiridoEm, m.CompraCompetencia)</span>
                            <span class="pat-meta">@(m.CompraValor > 0 ? $"R$ {m.CompraValor:N2}" : "Sem valor lançado")@(string.IsNullOrWhiteSpace(m.Local) ? "" : " · " + m.Local)</span>
                            @if (m.ControlaHora)
                            {
                                <span class="pat-chip">@m.Watts W</span>
                            }
                            else
                            {
                                <span class="pat-chip">Sem hora-máquina</span>
                            }
                        </span>
                    </a>
                    @if (aberto)
                    {
                        <div class="pat-detalhe">
                            <div class="pat-grade-det">
                                <p><span>Marca / modelo</span><strong>@(string.IsNullOrWhiteSpace(m.Marca) ? "—" : m.Marca)@(string.IsNullOrWhiteSpace(m.Modelo) ? "" : " · " + m.Modelo)</strong></p>
                                <p><span>Serial</span><strong>@(string.IsNullOrWhiteSpace(m.Serial) ? "—" : m.Serial)</strong></p>
                                <p><span>Status</span><strong>@(string.IsNullOrWhiteSpace(m.Status) ? "ativa" : m.Status)</strong></p>
                                <p><span>Local</span><strong>@(string.IsNullOrWhiteSpace(m.Local) ? "—" : m.Local)</strong></p>
                                @if (m.ControlaHora)
                                {
                                    <p><span>Depreciação</span><strong>R$ @m.DepreciacaoPorMinuto.ToString("N3")/min</strong></p>
                                    <p><span>Manutenção</span><strong>R$ @m.ManutencaoPorMinuto.ToString("N3")/min</strong></p>
                                    <p><span>Energia</span><strong>R$ @m.EnergiaPorMinuto.ToString("N4")/min</strong></p>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(m.Notas))
                            {
                                <p class="pat-notas">@m.Notas</p>
                            }
                            <form method="post" asp-page-handler="StatusMaquina" class="linha flex flex-wrap gap-2 mt-2">
                                <input type="hidden" name="id" value="@m.Id" />
                                <input type="hidden" name="aba" value="@Model.Aba" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <select name="status">
                                    @foreach (var s in new[] { "ativa", "manutencao", "parada", "baixada" })
                                    {
                                        if (m.Status == s) { <option value="@s" selected>@s</option> }
                                        else { <option value="@s">@s</option> }
                                    }
                                </select>
                                <button class="botao" type="submit">Atualizar status</button>
                            </form>
                        </div>
                    }
                </article>
            }
            </div>
        </section>
    }

    @if (Model.Insumos.Any())
    {
        <section class="pat-sec">
            <h2 class="pat-sec-titulo">@Model.TituloSecaoInsumos</h2>
            <div class="pat-grade">
            @foreach (var i in Model.Insumos)
            {
                var saldo = PatrimonioModel.SaldoDe(i);
                var alerta = saldo <= i.Minimo;
                var aberto = Model.Aberto == i.Id;
                var max = Math.Max(0.1m, Math.Max(i.Minimo * 2, saldo));
                var pct = (int)Math.Min(100, Math.Round(saldo / max * 100));
                var classeBarra = alerta ? "baixa" : (saldo <= i.Minimo * 1.5m ? "media" : "ok");
                var passo = i.Categoria == "filamento" || i.Cores.Any() ? 0.1m : 1m;
                var fil = i.Categoria == "filamento" || i.Cores.Any();
                var chip = fil
                    ? $"{i.Cores.Sum(c => c.Bobinas)} bobinas · {i.Cores.Count} cores"
                    : $"{PatrimonioModel.NomeCat(i.Categoria)} · {saldo.ToString("0.##").Replace('.', ',')} {(string.IsNullOrWhiteSpace(i.Unidade) ? "un" : i.Unidade)}";
                <article class="pat-card@(aberto ? " aberto" : "")@(alerta ? " alerta" : "")" data-id="@i.Id" data-tipo="insumo">
                    <a class="pat-card-btn no-underline text-tinta" asp-page="/Admin/Patrimonio" asp-route-aba="@Model.Aba" asp-route-q="@Model.Q" asp-route-id="@(aberto ? null : i.Id)">
                        <span class="pat-foto">
                            @if (!string.IsNullOrWhiteSpace(i.Imagem))
                            {
                                <img class="pat-thumb" src="~/@i.Imagem" alt="" />
                            }
                            else
                            {
                                <span class="pat-thumb vazia"><span class="ico"><partial name="_SvgIcon" model="@("caixa")" /></span></span>
                            }
                            <span class="pat-cat">@PatrimonioModel.NomeCat(i.Categoria)</span>
                            @if (alerta)
                            {
                                <span class="pat-alerta">Baixo</span>
                            }
                        </span>
                        <span class="pat-info">
                            <strong class="pat-nome">@i.Nome</strong>
                            <span class="pat-meta">Aquisição @PatrimonioModel.DataAq(i.AdquiridoEm, null)@(string.IsNullOrWhiteSpace(i.Fornecedor) ? "" : " · " + i.Fornecedor)</span>
                            <div class="pat-barra"><span class="pat-barra-fill @classeBarra" style="width:@pct%"></span></div>
                            <p class="pat-barra-txt">@saldo.ToString("0.##").Replace('.', ',') @i.Unidade · mín. @i.Minimo.ToString("0.##").Replace('.', ',')</p>
                            <span class="pat-chip">@chip</span>
                        </span>
                    </a>
                    @if (aberto)
                    {
                        <div class="pat-detalhe">
                            @if (!string.IsNullOrWhiteSpace(i.OrigemPlanilha))
                            {
                                <p class="pat-notas">Planilha: @i.OrigemPlanilha</p>
                            }
                            <p class="pat-det-titulo">@(fil ? "Quantidade por cor" : "Detalhe do estoque")</p>
                            <ul class="pat-cores">
                            @if (i.Cores.Any())
                            {
                                @foreach (var cor in i.Cores.OrderBy(c => c.Nome))
                                {
                                    <li class="pat-cor">
                                        <span class="pat-cor-swatch" style="background:@(string.IsNullOrWhiteSpace(cor.Hex) ? "#ccc" : cor.Hex)"></span>
                                        <span class="pat-cor-info"><strong>@cor.Nome</strong><small>@cor.Saldo.ToString("0.##").Replace('.', ',') @i.Unidade · @cor.Bobinas bobina@(cor.Bobinas == 1 ? "" : "s")</small></span>
                                        <span class="pat-cor-acoes">
                                            <form method="post" asp-page-handler="AjusteCor">
                                                <input type="hidden" name="id" value="@i.Id" />
                                                <input type="hidden" name="corId" value="@cor.Id" />
                                                <input type="hidden" name="delta" value="@(-passo)" />
                                                <input type="hidden" name="aba" value="@Model.Aba" />
                                                <input type="hidden" name="q" value="@Model.Q" />
                                                <button type="submit" aria-label="Retirar">−</button>
                                            </form>
                                            <form method="post" asp-page-handler="AjusteCor">
                                                <input type="hidden" name="id" value="@i.Id" />
                                                <input type="hidden" name="corId" value="@cor.Id" />
                                                <input type="hidden" name="delta" value="@passo" />
                                                <input type="hidden" name="aba" value="@Model.Aba" />
                                                <input type="hidden" name="q" value="@Model.Q" />
                                                <button type="submit" aria-label="Adicionar">+</button>
                                            </form>
                                        </span>
                                    </li>
                                }
                            }
                            else if (i.Variantes.Any())
                            {
                                @foreach (var v in i.Variantes.OrderBy(x => x.Nome))
                                {
                                    <li class="pat-cor">
                                        <span class="pat-cor-swatch" style="background:#e8772a"></span>
                                        <span class="pat-cor-info"><strong>@v.Nome</strong><small>@v.Saldo.ToString("0.##").Replace('.', ',') @(string.IsNullOrWhiteSpace(v.Unidade) ? i.Unidade : v.Unidade)</small></span>
                                        <span class="pat-cor-acoes">
                                            <form method="post" asp-page-handler="AjusteVariante">
                                                <input type="hidden" name="id" value="@i.Id" />
                                                <input type="hidden" name="varId" value="@v.Id" />
                                                <input type="hidden" name="delta" value="@(-passo)" />
                                                <input type="hidden" name="aba" value="@Model.Aba" />
                                                <input type="hidden" name="q" value="@Model.Q" />
                                                <button type="submit" aria-label="Retirar">−</button>
                                            </form>
                                            <form method="post" asp-page-handler="AjusteVariante">
                                                <input type="hidden" name="id" value="@i.Id" />
                                                <input type="hidden" name="varId" value="@v.Id" />
                                                <input type="hidden" name="delta" value="@passo" />
                                                <input type="hidden" name="aba" value="@Model.Aba" />
                                                <input type="hidden" name="q" value="@Model.Q" />
                                                <button type="submit" aria-label="Adicionar">+</button>
                                            </form>
                                        </span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="pat-cor">
                                    <span class="pat-cor-swatch" style="background:#148f93"></span>
                                    <span class="pat-cor-info"><strong>Saldo atual</strong><small>@i.Saldo.ToString("0.##").Replace('.', ',') @(string.IsNullOrWhiteSpace(i.Unidade) ? "un" : i.Unidade)</small></span>
                                    <span class="pat-cor-acoes">
                                        <form method="post" asp-page-handler="AjusteSaldo">
                                            <input type="hidden" name="id" value="@i.Id" />
                                            <input type="hidden" name="delta" value="@(-passo)" />
                                            <input type="hidden" name="aba" value="@Model.Aba" />
                                            <input type="hidden" name="q" value="@Model.Q" />
                                            <button type="submit" aria-label="Retirar">−</button>
                                        </form>
                                        <form method="post" asp-page-handler="AjusteSaldo">
                                            <input type="hidden" name="id" value="@i.Id" />
                                            <input type="hidden" name="delta" value="@passo" />
                                            <input type="hidden" name="aba" value="@Model.Aba" />
                                            <input type="hidden" name="q" value="@Model.Q" />
                                            <button type="submit" aria-label="Adicionar">+</button>
                                        </form>
                                    </span>
                                </li>
                            }
                            </ul>
                            @if (alerta)
                            {
                                <a class="botao at-btn" asp-page="/Admin/Financeiro" asp-route-aba="lancamentos" asp-route-mes="@Model.MesAtual">
                                    <span class="ico"><partial name="_SvgIcon" model="@("carrinho")" /></span><span>Lançar compra</span>
                                </a>
                            }
                        </div>
                    }
                </article>
            }
            </div>
        </section>
    }

    @if (!Model.Maquinas.Any() && !Model.Insumos.Any())
    {
        <div class="vazio"><p>Nada encontrado com esses filtros.</p></div>
    }
}
</div>
