@page
@model CriaLab.Web.Pages.Admin.PatrimonioModel
@using CriaLab.Web.Pages.Admin
@{
    ViewData["Title"] = "Patrimônio";
    string AbaCls(string a) => "cta-aba" + (Model.Aba == a ? " ativo" : "");
}
<div class="admin-prod-cab">
    <div>
        <h1 class="m-0">Patrimônio e estoque</h1>
        <p class="admin-prod-intro m-0 mt-1">Máquinas, filamentos, embalagens e saldos da oficina.</p>
    </div>
    <a class="botao-linha" asp-page="/Admin/Impressao">Fila de impressão</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <p class="cta-ok">@ok</p>
}

<div class="pat-kpis">
    <a class="painel-kpi no-underline" asp-page="/Admin/Patrimonio" asp-route-aba="maquinas"><strong>@Model.QtdMaquinas</strong><span>Máquinas</span></a>
    <a class="painel-kpi no-underline" asp-page="/Admin/Patrimonio" asp-route-aba="filamentos"><strong>@Model.QtdInsumos</strong><span>Insumos</span></a>
    <a class="painel-kpi no-underline @(Model.Alertas > 0 ? "pat-kpi-alerta" : "")" asp-page="/Admin/Patrimonio" asp-route-aba="tudo"><strong>@Model.Alertas</strong><span>Abaixo do mínimo</span></a>
</div>

<div class="cta-abas my-3">
    <a class="@AbaCls("tudo")" asp-page="/Admin/Patrimonio" asp-route-aba="tudo" asp-route-q="@Model.Q">Tudo</a>
    <a class="@AbaCls("maquinas")" asp-page="/Admin/Patrimonio" asp-route-aba="maquinas" asp-route-q="@Model.Q">Máquinas</a>
    <a class="@AbaCls("filamentos")" asp-page="/Admin/Patrimonio" asp-route-aba="filamentos" asp-route-q="@Model.Q">Filamentos</a>
    <a class="@AbaCls("embalagens")" asp-page="/Admin/Patrimonio" asp-route-aba="embalagens" asp-route-q="@Model.Q">Embalagens</a>
    <a class="@AbaCls("outros")" asp-page="/Admin/Patrimonio" asp-route-aba="outros" asp-route-q="@Model.Q">Outros</a>
</div>

<form method="get" class="mb-4 flex flex-wrap gap-2">
    <input type="hidden" name="aba" value="@Model.Aba" />
    <input type="search" name="q" value="@Model.Q" placeholder="Buscar máquina ou insumo" class="min-h-11 rounded-full border-2 border-linha px-4" />
    <button class="botao" type="submit">Buscar</button>
</form>

@if (Model.Maquinas.Any())
{
    <section class="pat-sec">
        <h2 class="pat-sec-titulo">Máquinas</h2>
        <div class="pat-grade">
        @foreach (var m in Model.Maquinas)
        {
            var aberto = Model.Aberto == m.Id;
            <article class="pat-card@(aberto ? " aberto" : "")">
                <a class="pat-card-btn no-underline text-tinta" asp-page="/Admin/Patrimonio" asp-route-aba="@Model.Aba" asp-route-q="@Model.Q" asp-route-id="@(aberto ? null : m.Id)">
                    <span class="pat-foto">
                        @if (!string.IsNullOrWhiteSpace(m.Imagem))
                        {
                            <img class="pat-thumb" src="~/@m.Imagem" alt="" />
                        }
                        else
                        {
                            <span class="pat-thumb vazia">⚙</span>
                        }
                        <span class="pat-cat">@PatrimonioModel.NomeCat(m.Categoria)</span>
                    </span>
                    <span class="pat-info">
                        <strong class="pat-nome">@m.Nome</strong>
                        <span class="pat-meta">Aquisição @(m.AdquiridoEm?.ToString("dd/MM/yyyy") ?? m.CompraCompetencia)</span>
                        <span class="pat-meta">@(m.CompraValor > 0 ? $"R$ {m.CompraValor:N2}" : "Sem valor")@(string.IsNullOrWhiteSpace(m.Local) ? "" : " · " + m.Local)</span>
                        <span class="pat-chip">@(m.ControlaHora ? $"{m.Watts} W" : "Sem hora-máquina") · @m.Status</span>
                    </span>
                </a>
                @if (aberto)
                {
                    <div class="pat-detalhe">
                        <div class="pat-grade-det">
                            <p><span>Marca / modelo</span><strong>@(m.Marca)@(string.IsNullOrWhiteSpace(m.Modelo) ? "" : " · " + m.Modelo)</strong></p>
                            <p><span>Serial</span><strong>@(string.IsNullOrWhiteSpace(m.Serial) ? "—" : m.Serial)</strong></p>
                            <p><span>Status</span><strong>@m.Status</strong></p>
                            <p><span>Local</span><strong>@(string.IsNullOrWhiteSpace(m.Local) ? "—" : m.Local)</strong></p>
                            @if (m.ControlaHora)
                            {
                                <p><span>Depreciação</span><strong>R$ @m.DepreciacaoPorMinuto.ToString("N3")/min</strong></p>
                                <p><span>Manutenção</span><strong>R$ @m.ManutencaoPorMinuto.ToString("N3")/min</strong></p>
                                <p><span>Energia</span><strong>R$ @m.EnergiaPorMinuto.ToString("N4")/min</strong></p>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(m.Notas))
                        {
                            <p class="pat-notas">@m.Notas</p>
                        }
                        <form method="post" asp-page-handler="StatusMaquina" class="linha flex flex-wrap gap-2 mt-2">
                            <input type="hidden" name="id" value="@m.Id" />
                            <input type="hidden" name="aba" value="@Model.Aba" />
                            <input type="hidden" name="q" value="@Model.Q" />
                            <select name="status">
                                @foreach (var s in new[] { "ativa", "manutencao", "parada", "baixada" })
                                {
                                    if (m.Status == s) { <option value="@s" selected>@s</option> }
                                    else { <option value="@s">@s</option> }
                                }
                            </select>
                            <button class="botao" type="submit">Atualizar status</button>
                        </form>
                    </div>
                }
            </article>
        }
        </div>
    </section>
}

@if (Model.Insumos.Any())
{
    <section class="pat-sec">
        <h2 class="pat-sec-titulo">Insumos</h2>
        <div class="pat-grade">
        @foreach (var i in Model.Insumos)
        {
            var saldo = PatrimonioModel.SaldoDe(i);
            var alerta = saldo <= i.Minimo;
            var aberto = Model.Aberto == i.Id;
            var max = Math.Max(0.1m, Math.Max(i.Minimo * 2, saldo));
            var pct = (int)Math.Min(100, Math.Round(saldo / max * 100));
            var classeBarra = alerta ? "baixa" : (saldo <= i.Minimo * 1.5m ? "media" : "ok");
            var passo = i.Categoria == "filamento" || i.Cores.Any() ? 0.1m : 1m;
            <article class="pat-card@(aberto ? " aberto" : "")@(alerta ? " alerta" : "")">
                <a class="pat-card-btn no-underline text-tinta" asp-page="/Admin/Patrimonio" asp-route-aba="@Model.Aba" asp-route-q="@Model.Q" asp-route-id="@(aberto ? null : i.Id)">
                    <span class="pat-foto">
                        @if (!string.IsNullOrWhiteSpace(i.Imagem))
                        {
                            <img class="pat-thumb" src="~/@i.Imagem" alt="" />
                        }
                        else
                        {
                            <span class="pat-thumb vazia">▣</span>
                        }
                        <span class="pat-cat">@PatrimonioModel.NomeCat(i.Categoria)</span>
                        @if (alerta)
                        {
                            <span class="pat-alerta">Baixo</span>
                        }
                    </span>
                    <span class="pat-info">
                        <strong class="pat-nome">@i.Nome</strong>
                        <span class="pat-meta">@(i.Cores.Any() ? $"{i.Cores.Sum(c => c.Bobinas)} bobinas · {i.Cores.Count} cores" : PatrimonioModel.NomeCat(i.Categoria))</span>
                        <div class="pat-barra"><span class="pat-barra-fill @classeBarra" style="width:@pct%"></span></div>
                        <p class="pat-barra-txt">@saldo.ToString("0.##") @i.Unidade · mín. @i.Minimo.ToString("0.##")</p>
                    </span>
                </a>
                @if (aberto)
                {
                    <div class="pat-detalhe">
                        <ul class="pat-cores m-0 p-0 list-none grid gap-2">
                        @if (i.Cores.Any())
                        {
                            @foreach (var cor in i.Cores.OrderBy(c => c.Nome))
                            {
                                <li class="pat-cor flex flex-wrap items-center gap-2">
                                    <span class="pat-cor-swatch" style="background:@cor.Hex"></span>
                                    <span class="pat-cor-info grow"><strong>@cor.Nome</strong><small class="block">@cor.Saldo.ToString("0.##") @i.Unidade · @cor.Bobinas bobina(s)</small></span>
                                    <span class="pat-cor-acoes flex gap-1">
                                        <form method="post" asp-page-handler="AjusteCor">
                                            <input type="hidden" name="id" value="@i.Id" />
                                            <input type="hidden" name="corId" value="@cor.Id" />
                                            <input type="hidden" name="delta" value="@(-passo)" />
                                            <input type="hidden" name="aba" value="@Model.Aba" />
                                            <input type="hidden" name="q" value="@Model.Q" />
                                            <button type="submit" aria-label="Retirar">−</button>
                                        </form>
                                        <form method="post" asp-page-handler="AjusteCor">
                                            <input type="hidden" name="id" value="@i.Id" />
                                            <input type="hidden" name="corId" value="@cor.Id" />
                                            <input type="hidden" name="delta" value="@passo" />
                                            <input type="hidden" name="aba" value="@Model.Aba" />
                                            <input type="hidden" name="q" value="@Model.Q" />
                                            <button type="submit" aria-label="Adicionar">+</button>
                                        </form>
                                    </span>
                                </li>
                            }
                        }
                        else if (i.Variantes.Any())
                        {
                            @foreach (var v in i.Variantes.OrderBy(x => x.Nome))
                            {
                                <li class="pat-cor flex flex-wrap items-center gap-2">
                                    <span class="pat-cor-swatch" style="background:#e8772a"></span>
                                    <span class="pat-cor-info grow"><strong>@v.Nome</strong><small class="block">@v.Saldo.ToString("0.##") @(string.IsNullOrWhiteSpace(v.Unidade) ? i.Unidade : v.Unidade)</small></span>
                                    <span class="pat-cor-acoes flex gap-1">
                                        <form method="post" asp-page-handler="AjusteVariante">
                                            <input type="hidden" name="id" value="@i.Id" />
                                            <input type="hidden" name="varId" value="@v.Id" />
                                            <input type="hidden" name="delta" value="@(-passo)" />
                                            <input type="hidden" name="aba" value="@Model.Aba" />
                                            <button type="submit">−</button>
                                        </form>
                                        <form method="post" asp-page-handler="AjusteVariante">
                                            <input type="hidden" name="id" value="@i.Id" />
                                            <input type="hidden" name="varId" value="@v.Id" />
                                            <input type="hidden" name="delta" value="@passo" />
                                            <input type="hidden" name="aba" value="@Model.Aba" />
                                            <button type="submit">+</button>
                                        </form>
                                    </span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="pat-cor flex flex-wrap items-center gap-2">
                                <span class="pat-cor-info grow"><strong>Saldo direto</strong><small class="block">@i.Saldo.ToString("0.##") @i.Unidade</small></span>
                                <span class="pat-cor-acoes flex gap-1">
                                    <form method="post" asp-page-handler="AjusteSaldo">
                                        <input type="hidden" name="id" value="@i.Id" />
                                        <input type="hidden" name="delta" value="@(-passo)" />
                                        <input type="hidden" name="aba" value="@Model.Aba" />
                                        <button type="submit">−</button>
                                    </form>
                                    <form method="post" asp-page-handler="AjusteSaldo">
                                        <input type="hidden" name="id" value="@i.Id" />
                                        <input type="hidden" name="delta" value="@passo" />
                                        <input type="hidden" name="aba" value="@Model.Aba" />
                                        <button type="submit">+</button>
                                    </form>
                                </span>
                            </li>
                        }
                        </ul>
                        <p class="discreto m-0 mt-2">Fornecedor: @(string.IsNullOrWhiteSpace(i.Fornecedor) ? "—" : i.Fornecedor)</p>
                    </div>
                }
            </article>
        }
        </div>
    </section>
}

@if (Model.Aba is "filamentos" or "embalagens" or "outros" or "tudo")
{
    <form method="post" asp-page-handler="NovoInsumo" class="cartao formulario p-4 mt-4">
        <h2 class="mt-0">Novo insumo</h2>
        <div class="grade grid grid-cols-1 gap-3 md:grid-cols-4">
            <label>Nome<input name="nome" required /></label>
            <label>Categoria
                <select name="categoria">
                    <option value="filamento">filamento</option>
                    <option value="embalagem">embalagem</option>
                    <option value="acabamento">acabamento</option>
                    <option value="ferragem">ferragem</option>
                </select>
            </label>
            <label>Unidade<input name="unidade" value="kg" /></label>
            <label>Mínimo<input name="minimo" type="number" step="0.1" min="0" value="1" /></label>
        </div>
        <button class="botao mt-2" type="submit">Criar</button>
    </form>
}

@if (!Model.Maquinas.Any() && !Model.Insumos.Any())
{
    <div class="vazio cartao"><p>Nada nesta aba.</p></div>
}
