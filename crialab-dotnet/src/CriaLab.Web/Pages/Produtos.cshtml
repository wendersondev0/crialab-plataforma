@page
@model CriaLab.Web.Pages.ProdutosModel
@{
    ViewData["Title"] = Model.Modalidade?.Nome ?? "Produtos";
}
@if (Model.Modalidade != null)
{
    <h1 class="text-3xl font-extrabold text-tinta mt-0" title="@Model.Modalidade.Resumo">@Model.Modalidade.Nome</h1>
    <p class="intro-modalidade intro-pagina max-w-3xl text-tinta/75">@Model.Modalidade.Explicacao</p>
}
else
{
    <h1 class="mt-0">Produtos</h1>
    <p class="intro-pagina max-w-3xl text-tinta/75">Todas as peças publicadas na vitrine.</p>
}

@if (!Model.Produtos.Any())
{
    <div class="vazio cartao"><p>Nada publicado nesta lista.</p></div>
}
else
{
    <div class="grade vitrine mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var p in Model.Produtos)
        {
            <partial name="_ProdutoCard" model="p" />
        }
    </div>
}
