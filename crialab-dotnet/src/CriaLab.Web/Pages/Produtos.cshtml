@page
@model CriaLab.Web.Pages.ProdutosModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.ModalidadeFiltro)
        ? "Produtos"
        : (Model.ModalidadeOpcoes.FirstOrDefault(x => x.Value == Model.ModalidadeFiltro)?.Text ?? "Produtos");
}
<h1 class="mt-0">@ViewData["Title"]</h1>
@if (!string.IsNullOrWhiteSpace(Model.ModalidadeFiltro))
{
    <p class="intro-modalidade">Filtrando por modalidade. Use o seletor para ver outras peças.</p>
}

<form method="get" class="filtros-loja">
    <label>
        Modalidade
        <select asp-for="ModalidadeFiltro" asp-items="Model.ModalidadeOpcoes">
            <option value="">Todas</option>
        </select>
    </label>
    <button class="botao" type="submit">Filtrar</button>
    <a class="botao-linha" asp-page="/Produtos">Limpar</a>
</form>

@if (!Model.Produtos.Any())
{
    <div class="vazio cartao"><p>Nenhuma peça encontrada nesta modalidade.</p></div>
}
else
{
    <div class="grade vitrine">
        @foreach (var p in Model.Produtos)
        {
            <partial name="_ProdutoCard" model="p" />
        }
    </div>
}
