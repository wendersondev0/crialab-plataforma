@page
@model CriaLab.Web.Pages.CarrinhoModel
@{
    ViewData["Title"] = "Carrinho";
}
<h1 class="mt-0 text-3xl font-extrabold text-tinta">Carrinho</h1>
@if (!Model.Itens.Any())
{
    <div class="vazio cartao">
        <p>Seu carrinho está vazio.</p>
        <a class="botao" asp-page="/Produtos">Ver produtos</a>
    </div>
}
else
{
    <div class="grade grid grid-cols-1 gap-3">
        @foreach (var i in Model.Itens)
        {
            <article class="cartao flex flex-wrap items-center justify-between gap-3 p-4">
                <div>
                    <strong class="block text-tinta">@i.Titulo</strong>
                    <span class="discreto">@i.Quantidade × R$ @i.PrecoUnitario.ToString("N2")</span>
                </div>
                <div class="flex items-center gap-3">
                    <strong>R$ @((i.PrecoUnitario * i.Quantidade).ToString("N2"))</strong>
                    <form method="post" asp-page-handler="Remover">
                        <input type="hidden" name="produtoId" value="@i.ProdutoId" />
                        <button class="botao-linha" type="submit">Remover</button>
                    </form>
                </div>
            </article>
        }
    </div>
    <div class="cartao mt-4 flex flex-wrap items-center justify-between gap-3 p-4">
        <p class="m-0 text-xl font-extrabold">Subtotal: R$ @Model.Subtotal.ToString("N2")</p>
        <div class="flex flex-wrap gap-2">
            <a class="botao-linha" asp-page="/Produtos">Continuar comprando</a>
            <a class="botao" asp-page="/Checkout">Finalizar pedido</a>
        </div>
    </div>
}
