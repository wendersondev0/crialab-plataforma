@using Microsoft.EntityFrameworkCore
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject CarrinhoService Carrinho
@inject ApplicationDbContext Db
@{
    var path = Context.Request.Path.Value ?? "";
    var qModalidade = Context.Request.Query["ModalidadeFiltro"].ToString();
    string Ativo(string trecho) => path.Contains(trecho, StringComparison.OrdinalIgnoreCase) ? " ativo" : "";
    string AtivoInicio() => path is "/" or "/Index" ? " ativo" : "";
    string AtivoModalidade(string id) =>
        string.Equals(qModalidade, id, StringComparison.OrdinalIgnoreCase) ? " ativo" : "";

    var identidade = await Db.LojaIdentidades.AsNoTracking().FirstOrDefaultAsync();
    var parceiros = await Db.Parceiros.AsNoTracking().Where(x => x.PodeAparecer).OrderBy(x => x.Nome).ToListAsync();
    var modalidades = await Db.Modalidades.AsNoTracking().ToListAsync();
    string DicaMod(string id) => modalidades.FirstOrDefault(m => m.Id == id)?.Resumo ?? "";
    var ajudaInicio = (await Db.MenusAjuda.AsNoTracking().FirstOrDefaultAsync(x => x.Id == "inicio"))?.Texto;
    var ajudaSobre = (await Db.MenusAjuda.AsNoTracking().FirstOrDefaultAsync(x => x.Id == "sobre"))?.Texto;
    var ajudaContato = (await Db.MenusAjuda.AsNoTracking().FirstOrDefaultAsync(x => x.Id == "contato"))?.Texto;
    var ajudaCarrinho = (await Db.MenusAjuda.AsNoTracking().FirstOrDefaultAsync(x => x.Id == "carrinho"))?.Texto;

    var nomeConta = "Conta";
    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        nomeConta = string.IsNullOrWhiteSpace(user?.NomeCompleto) ? (user?.Email ?? "Conta") : user!.NomeCompleto;
        if (nomeConta.Contains(' '))
            nomeConta = nomeConta.Split(' ')[0];
    }
    var qtd = Carrinho.QuantidadeTotal();
    var ehAdmin = User.IsInRole("Administrador");
    if (ViewData["FreteGratisAPartir"] == null)
    {
        var cfg = await Db.ConfiguracoesLoja.AsNoTracking().FirstOrDefaultAsync();
        ViewData["FreteGratisAPartir"] = cfg?.FreteGratisAPartir ?? 200m;
    }
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Cria Lab DM</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vitrine.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-razor.css" asp-append-version="true" />
</head>
<body class="text-tinta font-cria antialiased">
<header id="topo" class="topo-loja sticky top-0 z-20">
    <div class="faixa-fina bg-laranja-escuro">
        <div class="barra faixa-fina-barra mx-auto flex min-h-11 w-[min(1120px,calc(100%-32px))] items-center justify-between gap-3">
            <div class="siga flex items-center gap-2">
                <span class="siga-texto text-[0.92rem] font-bold text-white">Siga a Cria Lab</span>
                @if (!string.IsNullOrWhiteSpace(identidade?.Whatsapp))
                {
                    <a class="icone-topo" href="@identidade!.Whatsapp" target="_blank" rel="noopener" aria-label="WhatsApp"><partial name="_SvgIcon" model="@("whatsapp")" /></a>
                }
                @if (!string.IsNullOrWhiteSpace(identidade?.Instagram))
                {
                    <a class="icone-topo" href="@identidade!.Instagram" target="_blank" rel="noopener" aria-label="Instagram"><partial name="_SvgIcon" model="@("instagram")" /></a>
                }
                @if (!string.IsNullOrWhiteSpace(identidade?.Tiktok))
                {
                    <a class="icone-topo" href="@identidade!.Tiktok" target="_blank" rel="noopener" aria-label="TikTok"><partial name="_SvgIcon" model="@("tiktok")" /></a>
                }
                @if (!string.IsNullOrWhiteSpace(identidade?.Youtube))
                {
                    <a class="icone-topo" href="@identidade!.Youtube" target="_blank" rel="noopener" aria-label="YouTube"><partial name="_SvgIcon" model="@("youtube")" /></a>
                }
                @if (!string.IsNullOrWhiteSpace(identidade?.Shopee))
                {
                    <a class="icone-topo" href="@identidade!.Shopee" target="_blank" rel="noopener" aria-label="Shopee"><partial name="_SvgIcon" model="@("shopee")" /></a>
                }
                @if (!string.IsNullOrWhiteSpace(identidade?.MercadoLivre))
                {
                    <a class="icone-topo" href="@identidade!.MercadoLivre" target="_blank" rel="noopener" aria-label="Mercado Livre"><partial name="_SvgIcon" model="@("mercadolivre")" /></a>
                }
            </div>
        </div>
    </div>
    <div class="loja-faixa">
        <div class="barra loja-barra mx-auto flex min-h-[76px] w-[min(1120px,calc(100%-32px))] items-center gap-3">
            <button class="botao-hamburguer" type="button" id="abrir-menu" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-gaveta">
                <span class="ico"><partial name="_SvgIcon" model="@("menu")" /></span>
            </button>
            <a class="marca" asp-page="/Index">
                <img class="h-11 rounded-xl bg-white p-1" src="~/marca/logo-colorida.png" alt="Cria Lab DM" />
            </a>
            <form class="busca-topo flex min-w-0 flex-1 items-center gap-2 rounded-full bg-white py-1 pl-3 pr-1" asp-page="/Busca" method="get">
                <input class="min-h-10 min-w-0 flex-1 border-0 bg-transparent outline-none" name="q" type="search" placeholder="Buscar na Cria Lab" aria-label="Buscar na Cria Lab" value="@(Context.Request.Query["q"].ToString())" />
                <button class="botao botao-busca inline-flex min-h-10 items-center justify-center rounded-full bg-laranja px-4 font-bold text-white hover:bg-laranja-escuro" type="submit" aria-label="Buscar">
                    <span class="botao-busca-texto">Buscar</span>
                    <span class="botao-busca-ico ico" aria-hidden="true"><partial name="_SvgIcon" model="@("busca")" /></span>
                </button>
            </form>
            <div class="loja-acoes">
                <div class="acoes-util flex items-center gap-0">
                    <div class="menu-suspenso relative">
                        <button class="atalho" type="button" aria-label="Notificações" aria-expanded="false" aria-haspopup="true">
                            <span class="ico"><partial name="_SvgIcon" model="@("sino")" /></span>
                            <span class="atalho-texto">Notificações</span>
                        </button>
                        <div class="popup-topo" role="menu">
                            <p class="popup-vazio">Nenhuma notificação.</p>
                        </div>
                    </div>
                    <a class="atalho" asp-page="/Contato" aria-label="Ajuda" title="@ajudaContato">
                        <span class="ico"><partial name="_SvgIcon" model="@("contato")" /></span>
                        <span class="atalho-texto">Ajuda</span>
                    </a>
                    <div class="menu-suspenso menu-conta relative">
                        <button class="atalho" type="button" id="abrir-conta" aria-label="@nomeConta" aria-expanded="false" aria-haspopup="true">
                            <span class="ico"><partial name="_SvgIcon" model="@("conta")" /></span>
                            <span class="atalho-texto">@nomeConta</span>
                        </button>
                        <div class="popup-topo" role="menu">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <a class="item-popup-topo" asp-page="/Conta/Index"><span class="ico"><partial name="_SvgIcon" model="@("conta")" /></span><span>Minha conta</span></a>
                                <a class="item-popup-topo" asp-page="/Conta/Index"><span class="ico"><partial name="_SvgIcon" model="@("pedidos")" /></span><span>Meus pedidos</span></a>
                                @if (ehAdmin)
                                {
                                    <a class="item-popup-topo" asp-page="/Admin/Index"><span class="ico"><partial name="_SvgIcon" model="@("admin")" /></span><span>Administração</span></a>
                                }
                                <a class="item-popup-topo" asp-page="/Conta/Logout"><span class="ico"><partial name="_SvgIcon" model="@("sair")" /></span><span>Sair</span></a>
                            }
                            else
                            {
                                <a class="item-popup-topo" asp-page="/Conta/Login"><span class="ico"><partial name="_SvgIcon" model="@("conta")" /></span><span>Entrar</span></a>
                                <a class="item-popup-topo" asp-page="/Conta/Register"><span class="ico"><partial name="_SvgIcon" model="@("conta")" /></span><span>Criar conta</span></a>
                            }
                        </div>
                    </div>
                </div>
                <a class="nav-link@(Ativo("/Carrinho"))" asp-page="/Carrinho" title="@ajudaCarrinho">
                    <span class="ico"><partial name="_SvgIcon" model="@("carrinho")" /></span>
                    <span class="nav-texto nav-texto-carrinho">Carrinho</span>
                    @if (qtd > 0)
                    {
                        <span class="selo-qtd">@qtd</span>
                    }
                </a>
            </div>
        </div>
        <nav class="menu menu-loja mx-auto flex w-[min(1120px,calc(100%-32px))] flex-nowrap gap-1.5 overflow-x-auto overflow-y-visible pb-2.5">
            <a class="nav-link@(AtivoInicio())" asp-page="/Index" title="@ajudaInicio">
                <span class="ico"><partial name="_SvgIcon" model="@("casa")" /></span>
                <span class="nav-texto">Início</span>
            </a>
            <a class="nav-link@(AtivoModalidade("pronta-entrega"))" asp-page="/Produtos" asp-route-ModalidadeFiltro="pronta-entrega" title="@DicaMod("pronta-entrega")">
                <span class="ico"><partial name="_SvgIcon" model="@("caixa")" /></span>
                <span class="nav-texto">Pronta Entrega</span>
            </a>
            <a class="nav-link@(AtivoModalidade("sob-demanda"))" asp-page="/Produtos" asp-route-ModalidadeFiltro="sob-demanda" title="@DicaMod("sob-demanda")">
                <span class="ico"><partial name="_SvgIcon" model="@("caminhao")" /></span>
                <span class="nav-texto">Sob Demanda</span>
            </a>
            <a class="nav-link@(AtivoModalidade("personalizado"))" asp-page="/Produtos" asp-route-ModalidadeFiltro="personalizado" title="@DicaMod("personalizado")">
                <span class="ico"><partial name="_SvgIcon" model="@("admin")" /></span>
                <span class="nav-texto">Personalizados</span>
            </a>
            <a class="nav-link@(Ativo("/Sobre"))" asp-page="/Sobre" title="@ajudaSobre">
                <span class="ico"><partial name="_SvgIcon" model="@("sobre")" /></span>
                <span class="nav-texto nav-texto-longo">Sobre a Cria Lab</span>
                <span class="nav-texto nav-texto-curto">Sobre</span>
            </a>
        </nav>
    </div>
</header>

<div class="menu-gaveta" id="menu-gaveta">
    <button class="menu-gaveta-fundo" type="button" aria-label="Fechar menu"></button>
    <aside class="menu-gaveta-painel" role="dialog" aria-modal="true" aria-label="Menu da loja">
        <div class="menu-gaveta-topo">
            <strong>Menu</strong>
            <button class="botao-fechar-menu" type="button" id="fechar-menu" aria-label="Fechar menu">
                <span class="ico"><partial name="_SvgIcon" model="@("fechar")" /></span>
            </button>
        </div>
        <nav class="menu-gaveta-lista">
            <a class="nav-link" asp-page="/Index"><span class="ico"><partial name="_SvgIcon" model="@("casa")" /></span><span class="nav-texto">Início</span></a>
            <a class="nav-link" asp-page="/Produtos" asp-route-ModalidadeFiltro="pronta-entrega"><span class="ico"><partial name="_SvgIcon" model="@("caixa")" /></span><span class="nav-texto">Pronta Entrega</span></a>
            <a class="nav-link" asp-page="/Produtos" asp-route-ModalidadeFiltro="sob-demanda"><span class="ico"><partial name="_SvgIcon" model="@("caminhao")" /></span><span class="nav-texto">Sob Demanda</span></a>
            <a class="nav-link" asp-page="/Produtos" asp-route-ModalidadeFiltro="personalizado"><span class="ico"><partial name="_SvgIcon" model="@("admin")" /></span><span class="nav-texto">Personalizados</span></a>
            <a class="nav-link" asp-page="/Sobre"><span class="ico"><partial name="_SvgIcon" model="@("sobre")" /></span><span class="nav-texto nav-texto-longo">Sobre a Cria Lab</span><span class="nav-texto nav-texto-curto">Sobre</span></a>
            <a class="nav-link" asp-page="/Contato"><span class="ico"><partial name="_SvgIcon" model="@("contato")" /></span><span class="nav-texto">Ajuda / Contato</span></a>
            <a class="nav-link" asp-page="/Conta/Index"><span class="ico"><partial name="_SvgIcon" model="@("conta")" /></span><span class="nav-texto">Minha conta</span></a>
            <a class="nav-link" asp-page="/Carrinho"><span class="ico"><partial name="_SvgIcon" model="@("carrinho")" /></span><span class="nav-texto nav-texto-carrinho">Carrinho</span>@if (qtd > 0){<span class="selo-qtd">@qtd</span>}</a>
            @if (ehAdmin)
            {
                <a class="nav-link" asp-page="/Admin/Index"><span class="ico"><partial name="_SvgIcon" model="@("admin")" /></span><span class="nav-texto">Administração</span></a>
            }
        </nav>
    </aside>
</div>

<main id="conteudo" class="miolo">
    @RenderBody()
</main>

<footer id="rodape" class="rodape-loja">
    <div class="rodape-miolo">
        @if (parceiros.Any())
        {
            <section class="rodape-parceiros">
                <p class="rodape-parceiros-titulo">Parceiros</p>
                <div class="parceiros parceiros-rodape">
                    @foreach (var p in parceiros)
                    {
                        <figure class="parceiro parceiro-rodape" title="@p.Nome">
                            @if (!string.IsNullOrWhiteSpace(p.Logo))
                            {
                                <img src="~/@p.Logo" alt="@p.Nome" />
                            }
                            else
                            {
                                <span>@p.Nome</span>
                            }
                        </figure>
                    }
                </div>
            </section>
        }
        <div class="rodape-grade">
            <div class="rodape-marca">
                <img src="~/marca/logo-colorida.png" alt="Cria Lab DM" />
                <strong class="rodape-nome">@(identidade?.Nome ?? "Cria Lab DM")</strong>
                <p class="rodape-meta">Oficina de impressão 3D · peças prontas, sob demanda e personalizadas.</p>
                @if (!string.IsNullOrWhiteSpace(identidade?.Endereco))
                {
                    <p class="rodape-meta">@identidade!.Endereco</p>
                }
                @if (!string.IsNullOrWhiteSpace(identidade?.Horario))
                {
                    <p class="rodape-meta">@identidade!.Horario</p>
                }
            </div>
            <div class="rodape-bloco">
                <h2 class="rodape-titulo">Loja</h2>
                <nav class="rodape-nav">
                    <a class="rodape-link" asp-page="/Produtos" asp-route-ModalidadeFiltro="pronta-entrega">Pronta Entrega</a>
                    <a class="rodape-link" asp-page="/Produtos" asp-route-ModalidadeFiltro="sob-demanda">Sob Demanda</a>
                    <a class="rodape-link" asp-page="/Produtos" asp-route-ModalidadeFiltro="personalizado">Personalizados</a>
                    <a class="rodape-link" asp-page="/Sobre">Sobre a Cria Lab</a>
                    <a class="rodape-link" asp-page="/Contato">Contato</a>
                </nav>
            </div>
            <div class="rodape-bloco">
                <h2 class="rodape-titulo">Conta</h2>
                <nav class="rodape-nav">
                    <a class="rodape-link" asp-page="/Conta/Index">Minha conta</a>
                    <a class="rodape-link" asp-page="/Carrinho">Carrinho</a>
                    <a class="rodape-link" asp-page="/Busca">Busca</a>
                </nav>
                <div class="rodape-redes">
                    @if (!string.IsNullOrWhiteSpace(identidade?.Whatsapp))
                    {
                        <a class="rodape-rede" href="@identidade!.Whatsapp" target="_blank" rel="noopener" aria-label="WhatsApp"><partial name="_SvgIcon" model="@("whatsapp")" /></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(identidade?.Instagram))
                    {
                        <a class="rodape-rede" href="@identidade!.Instagram" target="_blank" rel="noopener" aria-label="Instagram"><partial name="_SvgIcon" model="@("instagram")" /></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(identidade?.Shopee))
                    {
                        <a class="rodape-rede" href="@identidade!.Shopee" target="_blank" rel="noopener" aria-label="Shopee"><partial name="_SvgIcon" model="@("shopee")" /></a>
                    }
                </div>
            </div>
        </div>
        <div class="rodape-base">
            <span>&copy; @DateTime.UtcNow.Year @(identidade?.Nome ?? "Cria Lab DM")</span>
            <span>CNPJ @(identidade?.Cnpj ?? "68.914.190/0001-96")</span>
        </div>
    </div>
</footer>
<script src="~/js/loja.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
