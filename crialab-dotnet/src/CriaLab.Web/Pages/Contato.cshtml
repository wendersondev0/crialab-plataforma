@page
@model CriaLab.Web.Pages.ContatoModel
@{
    ViewData["Title"] = "Contato";
}
<h1 class="mt-0 text-3xl font-extrabold text-tinta">Contato</h1>
<p class="intro-pagina max-w-3xl text-tinta/75">Fale com a oficina. Dúvida, elogio, reclamação ou orçamento.</p>
@if (!string.IsNullOrWhiteSpace(Model.Identidade?.Telefone) || !string.IsNullOrWhiteSpace(Model.Identidade?.Email))
{
    <div class="contato-linha my-4 flex flex-wrap gap-3">
        @if (!string.IsNullOrWhiteSpace(Model.Identidade?.Whatsapp))
        {
            <a class="botao" href="@Model.Identidade!.Whatsapp" target="_blank" rel="noopener"><span class="ico"><partial name="_SvgIcon" model="@("whatsapp")" /></span>WhatsApp</a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Identidade?.Email))
        {
            <a class="botao-linha" href="mailto:@Model.Identidade!.Email">@Model.Identidade.Email</a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Identidade?.Telefone))
        {
            <span class="discreto self-center">@Model.Identidade!.Telefone</span>
        }
    </div>
}
<form method="post" class="cartao formulario w-[min(720px,100%)]">
    <label>Nome<input asp-for="Nome" required /></label>
    <label>E-mail<input asp-for="Email" type="email" required /></label>
    <label>Tipo
        <select asp-for="Tipo">
            <option value="duvida">Dúvida</option>
            <option value="elogio">Elogio</option>
            <option value="reclamacao">Reclamação</option>
            <option value="orcamento">Orçamento</option>
        </select>
    </label>
    <label>Mensagem<textarea asp-for="Texto" required></textarea></label>
    <button class="botao" type="submit">Enviar</button>
</form>
@if (Model.Enviado)
{
    <p class="sys-ok mt-3 font-bold text-teal-escuro">Mensagem enviada. Obrigado!</p>
}
