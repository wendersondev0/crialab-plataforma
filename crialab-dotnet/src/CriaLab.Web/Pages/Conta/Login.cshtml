@page
@model CriaLab.Web.Pages.Conta.LoginModel
@{
    ViewData["Title"] = "Entrar";
}
<section class="w-[min(420px,100%)] mx-auto">
    <h1 class="mt-0 text-3xl font-extrabold text-tinta">Entrar</h1>
    <p class="intro-pagina text-tinta/75">Acesse pedidos, orçamentos e favoritos.</p>
    <form method="post" class="cartao formulario">
        <div asp-validation-summary="All"></div>
        <label>E-mail<input asp-for="Email" type="email" required /></label>
        <label>Senha<input asp-for="Senha" type="password" required /></label>
        <label class="flex items-center gap-2 font-semibold">
            <input asp-for="Lembrar" type="checkbox" style="width:auto;min-height:auto" /> Lembrar de mim
        </label>
        <button class="botao" type="submit">Entrar</button>
    </form>
    <p class="mt-3">Ainda não tem conta? <a class="font-bold text-teal-escuro" asp-page="/Conta/Register">Cadastre-se</a></p>
</section>
