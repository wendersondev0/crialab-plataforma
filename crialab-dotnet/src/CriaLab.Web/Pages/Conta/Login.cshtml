@page
@model CriaLab.Web.Pages.Conta.LoginModel
@{
    ViewData["Title"] = "Entrar";
}
<h1 class="mt-0">Entrar</h1>
<form method="post" class="cartao formulario">
    <div asp-validation-summary="All"></div>
    <label>E-mail<input asp-for="Email" type="email" required /></label>
    <label>Senha<input asp-for="Senha" type="password" required /></label>
    <label style="display:flex;align-items:center;gap:8px;font-weight:600">
        <input asp-for="Lembrar" type="checkbox" style="width:auto;min-height:auto" /> Lembrar de mim
    </label>
    <button class="botao" type="submit">Entrar</button>
</form>
<p class="mt-3">Ainda não tem conta? <a asp-page="/Conta/Register">Cadastre-se</a></p>
