@page
@model CriaLab.Web.Pages.Conta.IndexModel
@{
    ViewData["Title"] = "Minha conta";
}
<h1 class="mt-0 text-3xl font-extrabold text-tinta">Olá, @(Model.Usuario?.NomeCompleto ?? "cliente")</h1>
<p class="intro-pagina text-tinta/75">Pedidos, orçamentos e endereços da sua conta.</p>

<section class="cartao mb-4 p-4">
    <h2 class="mt-0">Pedidos</h2>
    @if (!Model.Pedidos.Any())
    {
        <p class="discreto">Nenhum pedido ainda.</p>
        <a class="botao" asp-page="/Produtos">Ver produtos</a>
    }
    else
    {
        <div class="grade grid grid-cols-1 gap-2">
            @foreach (var p in Model.Pedidos)
            {
                <article class="flex flex-wrap items-center justify-between gap-2 border-b border-linha py-3">
                    <div>
                        <strong>@p.Id</strong>
                        <span class="discreto block">@p.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </div>
                    <span>@p.Status</span>
                    <strong>R$ @p.Total.ToString("N2")</strong>
                </article>
            }
        </div>
    }
</section>

<section class="cartao mb-4 p-4">
    <h2 class="mt-0">Orçamentos</h2>
    @if (!Model.Orcamentos.Any())
    {
        <p class="discreto">Nenhum orçamento.</p>
    }
    @foreach (var o in Model.Orcamentos)
    {
        <article class="border-b border-linha py-3">
            <strong>@o.Titulo</strong>
            <span class="discreto"> · @o.Status · @(o.Valor.HasValue ? "R$ " + o.Valor.Value.ToString("N2") : "Aguardando valor")</span>
        </article>
    }
</section>

<section class="cartao p-4">
    <h2 class="mt-0">Endereços</h2>
    @if (!Model.Enderecos.Any())
    {
        <p class="discreto">Nenhum endereço cadastrado.</p>
    }
    @foreach (var e in Model.Enderecos)
    {
        <p class="m-0 py-2"><strong>@e.Rotulo</strong> · CEP @e.Cep · @e.Linha</p>
    }
    <form method="post" asp-page-handler="Logout" class="mt-4">
        <a class="botao-linha" asp-page="/Conta/Logout">Sair</a>
    </form>
</section>
