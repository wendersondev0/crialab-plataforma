@page
@model CriaLab.Web.Pages.Conta.RegisterModel
@{
    ViewData["Title"] = "Criar conta";
}
<section class="w-[min(420px,100%)] mx-auto">
    <h1 class="mt-0 text-3xl font-extrabold text-tinta">Criar conta</h1>
    <p class="intro-pagina text-tinta/75">Cadastro rápido para comprar e acompanhar pedidos.</p>
    <form method="post" class="cartao formulario">
        <div asp-validation-summary="All"></div>
        <label>Nome completo<input asp-for="NomeCompleto" required /></label>
        <label>E-mail<input asp-for="Email" type="email" required /></label>
        <label>Senha<input asp-for="Senha" type="password" required /></label>
        <label>Confirmar senha<input asp-for="ConfirmarSenha" type="password" required /></label>
        <button class="botao" type="submit">Criar conta</button>
    </form>
    <p class="mt-3">Já tem conta? <a class="font-bold text-teal-escuro" asp-page="/Conta/Login">Entrar</a></p>
</section>
