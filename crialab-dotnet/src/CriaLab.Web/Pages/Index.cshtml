@page
@model CriaLab.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Início";
    ViewData["FreteGratisAPartir"] = Model.FreteGratisAPartir;
    var freteTxt = Model.FreteGratisAPartir.ToString("N2");
}
<section class="carrossel revela visivel" id="carrossel">
    <div class="carrossel-trilho">
        <article class="slide fundo-laranja">
            <div class="slide-texto">
                <p class="selo">Cria Lab DM</p>
                <h2>Pronta entrega na oficina</h2>
                <p>Peças já impressas, prontas para envio ou retirada.</p>
            </div>
            <img class="slide-mascote" src="~/marca/mascote.png" alt="" />
        </article>
        <article class="slide fundo-teal">
            <div class="slide-texto">
                <p class="selo">Cria Lab DM</p>
                <h2>Sob demanda e personalizados</h2>
                <p>Modelo pronto para imprimir, ou peça sob medida com orçamento.</p>
            </div>
            <img class="slide-mascote" src="~/marca/mascote.png" alt="" />
        </article>
        <article class="slide fundo-tinta">
            <div class="slide-texto">
                <p class="selo">Cria Lab DM</p>
                <h2>Frete grátis a partir de R$ @freteTxt</h2>
                <p>Na ficha você simula PAC e SEDEX pelo CEP.</p>
            </div>
            <img class="slide-mascote" src="~/marca/mascote.png" alt="" />
        </article>
    </div>
    <button class="carrossel-seta anterior" type="button" data-passo="-1" aria-label="Anterior">‹</button>
    <button class="carrossel-seta proxima" type="button" data-passo="1" aria-label="Próximo">›</button>
    <div class="carrossel-pontos">
        <button type="button" data-slide="0" class="ativo" aria-label="Slide 1"></button>
        <button type="button" data-slide="1" aria-label="Slide 2"></button>
        <button type="button" data-slide="2" aria-label="Slide 3"></button>
    </div>
</section>

<p class="intro-pagina intro-home mt-4 mb-2 max-w-3xl text-tinta/75">Explore a vitrine da Cria Lab: modalidades, temas e peças para toque e abrir a ficha.</p>

<section class="faixa-categorias faixa-modalidades my-3">
    <p class="discreto m-0 mb-2 font-bold text-tinta/70">Modalidades</p>
    <div class="chips flex flex-wrap gap-2">
        @foreach (var m in Model.Modalidades)
        {
            <a class="chip revela visivel inline-flex min-h-11 items-center rounded-full border-2 border-linha bg-white px-3.5 font-bold text-tinta no-underline" asp-page="/Produtos" asp-route-ModalidadeFiltro="@m.Id" title="@m.Resumo">@m.Nome</a>
        }
    </div>
</section>

<section class="faixa-categorias my-3">
    <p class="discreto m-0 mb-2 font-bold text-tinta/70">Temas</p>
    <div class="chips chips-temas flex flex-nowrap gap-2 overflow-x-auto pb-1">
        @foreach (var c in Model.Categorias)
        {
            <a class="chip revela visivel inline-flex min-h-11 items-center rounded-full border-2 border-linha bg-white px-3.5 font-bold text-tinta no-underline" asp-page="/Busca" asp-route-categoria="@c.Id" title="Filtrar a busca por @c.Nome">@c.Nome</a>
        }
    </div>
</section>

<section class="mt-2">
    <div class="titulo-secao linha"><h2>Na loja</h2></div>
    <p class="discreto intro-grade mb-4 max-w-3xl">Cards sem botão: toque na peça para ver preço, frete, Shopee e Mercado Livre na ficha.</p>
    @if (!Model.Produtos.Any())
    {
        <div class="vazio cartao"><p>Nenhuma peça publicada ainda.</p></div>
    }
    else
    {
        <div class="grade vitrine grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var p in Model.Produtos)
            {
                <partial name="_ProdutoCard" model="p" />
            }
        </div>
    }
</section>
