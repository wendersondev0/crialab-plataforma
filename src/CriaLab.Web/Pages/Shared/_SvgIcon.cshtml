@if (string.Equals(Model, "shopee", StringComparison.OrdinalIgnoreCase))
{
    <img class="logo-canal" src="~/marca/shopee-branca.png" alt="" />
}
else if (string.Equals(Model, "mercadolivre", StringComparison.OrdinalIgnoreCase))
{
    <img class="logo-canal" src="~/marca/mercadolivre-branca.png" alt="" />
}
else if (mapa.TryGetValue(Model ?? "", out var svg))
{
    @Html.Raw(svg)
}
