@model CriaLab.Web.Data.Entities.Produto
@using CriaLab.Web.Services
@inject FavoritosService FavoritosSvc
@{
    var foto = Model.Fotos.OrderBy(f => f.Ordem).FirstOrDefault();
    var mod = Model.Modalidade?.Nome ?? Model.ModalidadeId;
    var tagClasse = LojaVitrineHelper.ClasseTag(Model.ModalidadeId);
    var freteGratis = ViewData["FreteGratisAPartir"] is decimal f ? f : 200m;
    var personalizado = string.Equals(Model.ModalidadeId, "personalizado", StringComparison.OrdinalIgnoreCase);
    var anterior = Model.PrecoComparativo;
    if (!(anterior > Model.Preco) && Model.Oferta)
        anterior = Math.Round(Model.Preco * 1.18m, 2);
    var temDesconto = !personalizado && anterior > Model.Preco;
    var entrega = LojaVitrineHelper.TextoEntrega(Model, freteGratis);
    var ehFav = (await FavoritosSvc.ObterIdsAsync()).Contains(Model.Id, StringComparer.OrdinalIgnoreCase);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<article class="produto revela visivel">
    <form method="post" asp-page="/Favorito" class="produto-fav-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button class="btn-favorito-card@(ehFav ? " ativo" : "")" type="submit" aria-label="@(ehFav ? "Remover dos favoritos" : "Salvar nos favoritos")" aria-pressed="@(ehFav ? "true" : "false")"><span class="ico"><partial name="_SvgIcon" model="@("coracao")" /></span></button>
    </form>
    <a class="produto-link" asp-page="/Produto" asp-route-id="@Model.Id">
        <span class="produto-foto">
            @if (foto != null)
            {
                <img src="~/@foto.Arquivo" alt="@(string.IsNullOrWhiteSpace(foto.Legenda) ? Model.Titulo : foto.Legenda)" />
            }
            else
            {
                <img src="~/marca/mascote.png" alt="@Model.Titulo" />
            }
            @if (temDesconto)
            {
                var pct = Math.Max(1, (int)Math.Round((1 - Model.Preco / anterior) * 100));
                <span class="selo-oferta">-@pct%</span>
            }
            else if (Model.Oferta)
            {
                <span class="selo-oferta">Oferta</span>
            }
        </span>
        <span class="produto-corpo">
            <span class="tag @tagClasse">@mod</span>
            <span class="discreto">@(Model.Categoria?.Nome ?? Model.CategoriaId)</span>
            <h3>@Model.Titulo</h3>
            @if (Model.Nota > 0)
            {
                <p class="nota-card"><span>@Model.Nota.ToString("0.#")</span> <span class="estrelas" aria-hidden="true">★★★★★</span></p>
            }
            @if (personalizado)
            {
                <p class="preco-card">R$ @Model.Preco.ToString("N2")</p>
                <p class="discreto preco-media">Preço médio · fecha no orçamento</p>
            }
            else if (temDesconto)
            {
                <div class="preco-linha">
                    <p class="preco-card">R$ @Model.Preco.ToString("N2")</p>
                    <s class="preco-riscado">R$ @anterior.ToString("N2")</s>
                </div>
            }
            else
            {
                <p class="preco-card">R$ @Model.Preco.ToString("N2")</p>
            }
            <p class="entrega-card">@Html.Raw(entrega)</p>
        </span>
    </a>
</article>
