@using CriaLab.Web.Pages.Admin
@model (ImpressaoModel Page, CriaLab.Web.Data.Entities.ImpressaoJob Job, bool SemAcoes)
@{
    var p = Model.Page;
    var j = Model.Job;
    var choque = p.JobsEmChoque.Contains(j.Id);
    var andamento = ImpressaoModel.Andamento(j);
    var aberto = p.ConcluirId == j.Id && j.Status is not ("concluida" or "cancelada");
}
<article class="imp-card@(choque ? " choque" : "")@(j.Status == "imprimindo" ? " ativo" : "")">
    <div class="imp-card-topo">
        <div>
            <strong class="imp-titulo">@j.Titulo</strong>
            <p class="imp-meta">@(j.Maquina?.Nome ?? "Máquina") · @ImpressaoModel.FmtQuando(j.Inicio) → @ImpressaoModel.FmtQuando(j.Fim)</p>
        </div>
        <span class="@p.SeloStatus(j)">@p.TextoStatus(j)</span>
    </div>
    @if (j.Status is "imprimindo" or "pausada")
    {
        <div class="imp-barra"><span style="width:@(andamento.Progresso)%"></span></div>
        <p class="imp-meta">@andamento.Progresso% · @andamento.Restante</p>
    }
    @if (choque)
    {
        <p class="imp-aviso">Choque de horário nesta máquina.</p>
    }
    @if (!string.IsNullOrWhiteSpace(j.Motivo))
    {
        <p class="imp-meta">Motivo: @j.Motivo</p>
    }
    @if (j.Status == "concluida")
    {
        <p class="imp-meta">Peso real @j.PesoReal.ToString("0.##").Replace('.', ',') g · @j.Kwh.ToString("0.##") kWh</p>
    }
    @if (!Model.SemAcoes && j.Status is not ("concluida" or "cancelada"))
    {
        <div class="imp-acoes">
            @if (j.Status == "na fila")
            {
                <form method="post" asp-page="/Admin/Impressao" asp-page-handler="Status">
                    <input type="hidden" name="id" value="@j.Id" />
                    <input type="hidden" name="status" value="imprimindo" />
                    <input type="hidden" name="aba" value="@p.Aba" />
                    <input type="hidden" name="maquina" value="@p.MaquinaFiltro" />
                    <input type="hidden" name="statusFiltro" value="@p.StatusFiltro" />
                    <input type="hidden" name="q" value="@p.Q" />
                    <button class="botao" type="submit"><span class="ico"><partial name="_SvgIcon" model="@("admin")" /></span><span>Iniciar</span></button>
                </form>
            }
            @if (j.Status == "imprimindo")
            {
                <form method="post" asp-page="/Admin/Impressao" asp-page-handler="Status">
                    <input type="hidden" name="id" value="@j.Id" />
                    <input type="hidden" name="status" value="pausada" />
                    <input type="hidden" name="aba" value="@p.Aba" />
                    <input type="hidden" name="maquina" value="@p.MaquinaFiltro" />
                    <input type="hidden" name="q" value="@p.Q" />
                    <button class="botao-linha" type="submit"><span>Pausar</span></button>
                </form>
            }
            @if (j.Status is "pausada" or "erro")
            {
                <form method="post" asp-page="/Admin/Impressao" asp-page-handler="Status">
                    <input type="hidden" name="id" value="@j.Id" />
                    <input type="hidden" name="status" value="imprimindo" />
                    <input type="hidden" name="aba" value="@p.Aba" />
                    <input type="hidden" name="maquina" value="@p.MaquinaFiltro" />
                    <input type="hidden" name="q" value="@p.Q" />
                    <button class="botao" type="submit"><span>Retomar</span></button>
                </form>
            }
            <a class="botao-teal" asp-page="/Admin/Impressao" asp-route-aba="@p.Aba" asp-route-maquina="@p.MaquinaFiltro" asp-route-status="@p.StatusFiltro" asp-route-q="@p.Q" asp-route-concluir="@j.Id">
                <span class="ico"><partial name="_SvgIcon" model="@("documento")" /></span><span>Concluir</span>
            </a>
            <form method="post" asp-page="/Admin/Impressao" asp-page-handler="Status">
                <input type="hidden" name="id" value="@j.Id" />
                <input type="hidden" name="status" value="cancelada" />
                <input type="hidden" name="aba" value="@p.Aba" />
                <input type="hidden" name="maquina" value="@p.MaquinaFiltro" />
                <input type="hidden" name="q" value="@p.Q" />
                <button class="botao-linha" type="submit"><span>Cancelar</span></button>
            </form>
        </div>
    }
    @if (aberto)
    {
        <form method="post" asp-page="/Admin/Impressao" asp-page-handler="Concluir" class="imp-concluir">
            <input type="hidden" name="id" value="@j.Id" />
            <input type="hidden" name="aba" value="@p.Aba" />
            <input type="hidden" name="maquina" value="@p.MaquinaFiltro" />
            <input type="hidden" name="status" value="@p.StatusFiltro" />
            <input type="hidden" name="q" value="@p.Q" />
            <p class="imp-meta m-0">Informe o resultado. Sucesso baixa estoque da peça; falha baixa só o filamento.</p>
            <div class="imp-concluir-grade">
                <label class="fin-campo"><span>Resultado</span>
                    <select name="sucesso">
                        <option value="1">Sucesso</option>
                        <option value="0">Falha</option>
                    </select>
                </label>
                <label class="fin-campo"><span>Peso real (g)</span><input name="peso" type="number" step="0.01" value="@(j.PesoPrevisto > 0 ? j.PesoPrevisto : 40)" required /></label>
                <label class="fin-campo"><span>kWh</span><input name="kwh" type="number" step="0.01" value="@(j.Kwh > 0 ? j.Kwh : 0)" /></label>
                <label class="fin-campo imp-span2"><span>Motivo (se falha)</span><input name="motivo" placeholder="Ex.: Descolou da mesa" /></label>
            </div>
            <div class="imp-acoes">
                <button class="botao" type="submit">Salvar conclusão</button>
                <a class="botao-linha" asp-page="/Admin/Impressao" asp-route-aba="@p.Aba" asp-route-maquina="@p.MaquinaFiltro" asp-route-status="@p.StatusFiltro" asp-route-q="@p.Q">Fechar</a>
            </div>
        </form>
    }
</article>
