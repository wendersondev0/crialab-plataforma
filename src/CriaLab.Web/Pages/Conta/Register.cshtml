@page
@model CriaLab.Web.Pages.Conta.RegisterModel
@{
    ViewData["Title"] = "Criar conta";
}
<section class="entrada w-[min(420px,100%)] mx-auto">
    <div class="cartao p-5">
        <h1 class="mt-0 text-3xl font-extrabold text-tinta">Criar conta</h1>
        <p class="intro-pagina text-tinta/75 m-0 mb-4">Cadastro rápido para comprar e acompanhar pedidos.</p>
        <form method="post" class="formulario">
            <div asp-validation-summary="All"></div>
            <label>Nome completo<input asp-for="NomeCompleto" required /></label>
            <label>E-mail<input asp-for="Email" type="email" required autocomplete="username" /></label>
            <label>Senha<input asp-for="Senha" type="password" required autocomplete="new-password" /></label>
            <label>Confirmar senha<input asp-for="ConfirmarSenha" type="password" required autocomplete="new-password" /></label>
            <button class="botao w-full" type="submit">Criar conta</button>
        </form>
        <p class="mt-4 mb-0">Já tem conta? <a class="font-bold text-teal-escuro" asp-page="/Conta/Login">Entrar</a></p>
    </div>
</section>
