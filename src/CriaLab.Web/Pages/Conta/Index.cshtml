@page
@model CriaLab.Web.Pages.Conta.IndexModel
@{
    ViewData["Title"] = "Minha conta";
    string ClasseAba(string nome) => "cta-aba" + (Model.Aba == nome ? " ativo" : "");
    string ClasseKpi(string nome) => "cta-kpi" + (Model.Aba == nome ? " ativo" : "");
}
<div class="cta-cab">
    <div class="cta-cab-txt">
        <p class="cta-eyebrow">Minha conta</p>
        <h1 class="cta-nome">@(Model.Usuario?.NomeCompleto ?? "Cliente")</h1>
        <p class="cta-intro">Nome, contato e endereços usados nas compras.</p>
    </div>
    <a class="botao-linha" asp-page="/Conta/Logout">Sair</a>
</div>

<div class="cta-kpis cta-kpis-2">
    <a class="@ClasseKpi("dados")" asp-page="/Conta/Index" asp-route-aba="dados"><strong>Dados</strong><span>Nome e contato</span></a>
    <a class="@ClasseKpi("enderecos")" asp-page="/Conta/Index" asp-route-aba="enderecos"><strong>@Model.Enderecos.Count</strong><span>Endereços</span></a>
</div>

<div class="cta-abas">
    <a class="@ClasseAba("dados")" asp-page="/Conta/Index" asp-route-aba="dados">Meus dados</a>
    <a class="@ClasseAba("enderecos")" asp-page="/Conta/Index" asp-route-aba="enderecos">Endereços</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <p class="cta-ok">@ok</p>
}

<div class="cta-corpo">
@if (Model.Aba == "enderecos")
{
    <div class="cta-endereco-layout">
        <div class="cta-lista">
        @if (!Model.Enderecos.Any())
        {
            <div class="vazio cartao"><p>Nenhum endereço guardado.</p></div>
        }
        @foreach (var e in Model.Enderecos)
        {
            <article class="cta-card cta-end">
                <div class="cta-card-topo">
                    <strong class="cta-id">@e.Rotulo</strong>
                    <form method="post" asp-page-handler="RemoverEndereco">
                        <input type="hidden" name="id" value="@e.Id" />
                        <button class="botao-linha" type="submit">Remover</button>
                    </form>
                </div>
                <p class="cta-itens m-0">@e.Linha</p>
                <p class="cta-meta m-0">CEP @e.Cep</p>
            </article>
        }
        </div>
        <form method="post" asp-page-handler="Endereco" class="cta-card cta-form">
            <h2 class="cta-titulo">Novo endereço</h2>
            <label class="cta-campo"><span>Apelido</span><input asp-for="Rotulo" placeholder="Casa, Trabalho…" /></label>
            <label class="cta-campo"><span>Endereço completo</span><input asp-for="Linha" required placeholder="Rua, número, bairro, cidade/UF" /></label>
            <label class="cta-campo"><span>CEP</span><input asp-for="Cep" required inputmode="numeric" placeholder="29000-000" /></label>
            <button class="botao" type="submit">Guardar endereço</button>
        </form>
    </div>
}
else
{
    <form method="post" asp-page-handler="Dados" class="cta-card cta-form cta-dados">
        <h2 class="cta-titulo">Dados pessoais</h2>
        <p class="cta-meta">Atualize nome, telefone e documento da conta.</p>
        <div class="cta-grade">
            <label class="cta-campo"><span>Nome</span><input asp-for="NomeCompleto" /></label>
            <label class="cta-campo"><span>E-mail</span><input value="@(Model.Usuario?.Email)" disabled /></label>
            <label class="cta-campo"><span>Telefone</span><input asp-for="TelefoneContato" /></label>
            <label class="cta-campo"><span>Documento</span><input asp-for="Documento" /></label>
        </div>
        <button class="botao" type="submit">Salvar dados</button>
    </form>
}
</div>
