{
  "name": "crialab-plataforma",
  "version": "1.0.0",
  "description": "Loja estática Cria Lab DM",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./css/entrada.css -o ./css/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./css/entrada.css -o ./css/tailwind.css --watch",
    "deploy": "npm run build && npx wrangler deploy",
    "preview": "npx wrangler versions upload",
    "otimizar-fotos": "node scripts/otimizar-fotos.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wendersondev0/crialab-plataforma.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wendersondev0/crialab-plataforma/issues"
  },
  "homepage": "https://github.com/wendersondev0/crialab-plataforma#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.45.3"
  }
}
